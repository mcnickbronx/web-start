# Задачи проекта по расписанию: уборка модулей и свои. Их запускает сервис cron (compose.yml).
# Формат — как у обычного cron, время — московское (строка CRON_TZ ниже: контейнер живёт по UTC):
#   минута час день_месяца месяц день_недели  команда
#   */5 * * * *   каждые 5 минут
#   0 * * * *     раз в час, в начале часа
#   0 4 * * *     раз в сутки, в 04:00
#   0 4 * * 1     по понедельникам, в 04:00
# Удалили модуль — уберите здесь его строку. Вывод задач — docker compose logs cron

CRON_TZ=Europe/Moscow

0 4 * * *     python manage.py clear_log
30 4 * * *    python manage.py clear_form_files
